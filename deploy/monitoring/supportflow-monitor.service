[Unit]
Description=SupportFlow site monitoring and renewal reminders
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=supportflow
Group=supportflow
WorkingDirectory=/opt/supportflow/biometrics-release
ExecStart=/opt/supportflow/node22/node_modules/node/bin/node --env-file=.env.local scripts/monitor.mjs
TimeoutStartSec=240
MemoryMax=192M
CPUQuota=25%
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
