DATABASE_URL=postgresql://supportflow:local-development-only@localhost:5432/supportflow
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Optional: HTTPS origin of an existing Mailcow server, without /api/v1.
# Leave both empty for manual provisioning by the team.
MAILCOW_API_URL=
MAILCOW_API_KEY=


# Optional local Postfix/Dovecot broker. Install and validate the pilot first.
# LOCAL_MAIL_SOCKET=/run/supportflow-mail/broker.sock

# Email delivery: credentials entered privately on the VPS. No NEXT_PUBLIC prefix.
SMTP_HOST=mail.solumove.net
SMTP_PORT=587
SMTP_USER=contact@solumove.net
SMTP_PASSWORD=
# Generate once: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Private persistent invoice storage, outside public and release directories.
INVOICE_STORAGE_DIR=/opt/supportflow/private-invoices
