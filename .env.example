DATABASE_URL=postgresql://supportflow:local-development-only@localhost:5432/supportflow
# Public origin of the portal. Passkeys (Face ID / fingerprint) are bound to this hostname: use the final domain in production.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Shown in e-mails, on invoices and in authenticator apps.
COMPANY_NAME=Votre société
COMPANY_ADDRESS=
COMPANY_TAX_ID=
COMPANY_CONTACT=

# Outgoing e-mail (tickets, invoices, password reset). Without SMTP_HOST and MAIL_FROM, e-mails are logged as "not sent".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Support <support@example.com>

# Push notifications. Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Set to false to let people in without enabling notifications on their device.
FORCE_NOTIFICATIONS=true
# Set to false only for local development.
REQUIRE_TWO_FACTOR=true

# Secret for the scheduled job: GET /api/cron with "Authorization: Bearer <secret>" every 10-15 minutes.
CRON_SECRET=

# Optional: HTTPS origin of an existing Mailcow server, without /api/v1.
# Leave both empty for manual provisioning by the team. Required to measure real mailbox usage.
MAILCOW_API_URL=
MAILCOW_API_KEY=
