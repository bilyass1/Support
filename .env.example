DATABASE_URL=postgresql://supportflow:local-development-only@localhost:5432/supportflow
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Optional: HTTPS origin of an existing Mailcow server, without /api/v1.
# Leave both empty for manual provisioning by the team.
MAILCOW_API_URL=
MAILCOW_API_KEY=


# Optional local Postfix/Dovecot broker. Install and validate the pilot first.
# LOCAL_MAIL_SOCKET=/run/supportflow-mail/broker.sock
