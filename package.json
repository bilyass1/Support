{
  "name": "supportflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "admin:grant": "node --env-file=.env.local scripts/grant-admin.mjs",
    "test:e2e": "playwright test",
    "notifications:deliver": "node --env-file=.env.local scripts/deliver-notifications.mjs",
    "notifications:check": "node --env-file=.env.local scripts/check-notifications.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "lucide-react": "1.56.0",
    "next": "16.4.3",
    "nodemailer": "^10.1.1",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-qr-code": "^2.2.0",
    "web-push": "^3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@playwright/test": "^1.64.1",
    "@types/node": "26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "^3.6.4",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
